// Digital Event Platform - Complete Prisma Schema
// DROP-IN REPLACEMENT for backend/prisma/schema.prisma
// Includes: LIVE_LANDING and EVENT_ENDED template types

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"  // Change to "sqlite" for local dev if needed
  url      = env("DATABASE_URL")
}

// ============================================
// ADMIN & AUTHENTICATION
// ============================================

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // admin | superadmin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

// ============================================
// OWNER MANAGEMENT
// ============================================

model Owner {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  
  // Authentication
  passwordHash String?
  
  // Status
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  events Event[]
  wallet OwnerWallet?
  payoutRequests PayoutRequest[]
}

model OwnerWallet {
  id      String @id @default(uuid())
  ownerId String @unique

  // Bank Account Details
  bankName      String?
  accountName   String?
  accountNumber String?
  routingNumber String?
  swiftCode     String?

  // Mobile Money (Africa)
  mobileProvider String?
  mobileNumber   String?

  // Digital Wallets
  paypalEmail        String?
  stripeAccountId    String?
  paystackSubaccount String?

  // Payout Preferences
  preferredMethod     String  @default("bank")
  currency            String  @default("USD")
  autoPayoutEnabled   Boolean @default(false)
  autoPayoutThreshold Float   @default(100)

  // Verification
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// ============================================
// EVENT MANAGEMENT
// ============================================

model Event {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  date        DateTime
  endDate     DateTime?
  timezone    String   @default("UTC")
  venue       String?
  
  // Owner
  ownerId String?
  
  // Couple Contact Information
  coupleName1  String?
  coupleName2  String?
  coupleEmail  String?
  couplePhone  String?
  
  // Event Styling
  primaryColor   String @default("#FFD700")
  secondaryColor String @default("#1a1a2e")
  accentColor    String @default("#ffffff")
  
  // Event Phase Control
  phase         String  @default("PRE_EVENT") // PRE_EVENT | LIVE | POST_EVENT
  phaseOverride Boolean @default(false)
  
  // Service Flags
  invitationEnabled Boolean @default(true)
  rsvpEnabled       Boolean @default(true)
  guestbookEnabled  Boolean @default(true)
  checkInEnabled    Boolean @default(true)
  
  // Invitation-Only Flag
  invitationOnly Boolean @default(false)
  
  // Template Assignments - ⭐ INCLUDES NEW TEMPLATE TYPES
  invitationTemplateId     String?
  rsvpTemplateId           String?
  guestbookTemplateId      String?
  guestbookVideoTemplateId String?
  guestbookAudioTemplateId String?
  guestbookPhotoTemplateId String?
  boothTemplateId          String?
  boothVideoTemplateId     String?
  boothAudioTemplateId     String?
  boothPhotoTemplateId     String?
  thankYouTemplateId       String?
  liveLandingTemplateId    String?  // ⭐ NEW - LIVE phase landing page
  eventEndedTemplateId     String?  // ⭐ NEW - POST_EVENT landing page
  
  // Couple Portal Access
  coupleAccessToken String @unique @default(uuid())
  
  // Guestbook Settings
  maxRecordingDuration Int @default(120)
  minRecordingDuration Int @default(30)
  maxPhotosPerGuest    Int @default(5)
  
  // Reel Generation
  reelEnabled Boolean @default(false)
  
  // Notification Settings
  notifyOnRsvp          Boolean @default(true)
  notifyOnCheckIn       Boolean @default(false)
  notifyOnGuestbook     Boolean @default(false)
  emailNotifications    Boolean @default(true)
  smsNotifications      Boolean @default(false)
  whatsappNotifications Boolean @default(false)
  
  // Metadata
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations - ⭐ INCLUDES NEW TEMPLATE RELATIONS
  owner                  Owner?     @relation(fields: [ownerId], references: [id])
  invitationTemplate     Template?  @relation("InvitationTemplate", fields: [invitationTemplateId], references: [id])
  rsvpTemplate           Template?  @relation("RsvpTemplate", fields: [rsvpTemplateId], references: [id])
  guestbookTemplate      Template?  @relation("GuestbookTemplate", fields: [guestbookTemplateId], references: [id])
  guestbookVideoTemplate Template?  @relation("GuestbookVideoTemplate", fields: [guestbookVideoTemplateId], references: [id])
  guestbookAudioTemplate Template?  @relation("GuestbookAudioTemplate", fields: [guestbookAudioTemplateId], references: [id])
  guestbookPhotoTemplate Template?  @relation("GuestbookPhotoTemplate", fields: [guestbookPhotoTemplateId], references: [id])
  boothTemplate          Template?  @relation("BoothTemplate", fields: [boothTemplateId], references: [id])
  boothVideoTemplate     Template?  @relation("BoothVideoTemplate", fields: [boothVideoTemplateId], references: [id])
  boothAudioTemplate     Template?  @relation("BoothAudioTemplate", fields: [boothAudioTemplateId], references: [id])
  boothPhotoTemplate     Template?  @relation("BoothPhotoTemplate", fields: [boothPhotoTemplateId], references: [id])
  thankYouTemplate       Template?  @relation("ThankYouTemplate", fields: [thankYouTemplateId], references: [id])
  liveLandingTemplate    Template?  @relation("LiveLandingTemplate", fields: [liveLandingTemplateId], references: [id])  // ⭐ NEW
  eventEndedTemplate     Template?  @relation("EventEndedTemplate", fields: [eventEndedTemplateId], references: [id])   // ⭐ NEW
  
  rsvps       RSVP[]
  invitations Invitation[]
  checkIns    CheckIn[]
  mediaAssets MediaAsset[]
  broadcasts  Broadcast[]
  auditLogs   AuditLog[]
  payoutWallet PayoutWallet?
  transactions Transaction[]
}

// ============================================
// TEMPLATE SYSTEM - ⭐ INCLUDES NEW TYPES
// ============================================

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  
  // Template Type - ⭐ NOW INCLUDES: LIVE_LANDING | EVENT_ENDED
  // Full list: INVITATION | RSVP | GUESTBOOK | GUESTBOOK_VIDEO | GUESTBOOK_AUDIO | 
  //            GUESTBOOK_PHOTO | BOOTH | BOOTH_VIDEO | BOOTH_AUDIO | BOOTH_PHOTO | 
  //            THANK_YOU | LIVE_LANDING | EVENT_ENDED
  type String
  
  // Template Content
  htmlContent String
  cssContent  String?
  jsContent   String?
  
  // Template Variables (JSON schema)
  variables String?
  
  // Metadata
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - ⭐ INCLUDES NEW TEMPLATE RELATIONS
  eventsAsInvitation     Event[] @relation("InvitationTemplate")
  eventsAsRsvp           Event[] @relation("RsvpTemplate")
  eventsAsGuestbook      Event[] @relation("GuestbookTemplate")
  eventsAsGuestbookVideo Event[] @relation("GuestbookVideoTemplate")
  eventsAsGuestbookAudio Event[] @relation("GuestbookAudioTemplate")
  eventsAsGuestbookPhoto Event[] @relation("GuestbookPhotoTemplate")
  eventsAsBooth          Event[] @relation("BoothTemplate")
  eventsAsBoothVideo     Event[] @relation("BoothVideoTemplate")
  eventsAsBoothAudio     Event[] @relation("BoothAudioTemplate")
  eventsAsBoothPhoto     Event[] @relation("BoothPhotoTemplate")
  eventsAsThankYou       Event[] @relation("ThankYouTemplate")
  eventsAsLiveLanding    Event[] @relation("LiveLandingTemplate")  // ⭐ NEW
  eventsAsEventEnded     Event[] @relation("EventEndedTemplate")   // ⭐ NEW
}

// ============================================
// RSVP SYSTEM
// ============================================

model RSVP {
  id        String   @id @default(uuid())
  eventId   String
  
  // Guest Information
  primaryName   String
  secondaryName String?
  email         String?
  phone         String?
  
  // Response
  attendance    String   @default("PENDING")
  guestCount    Int      @default(1)
  mealPreference String?
  dietaryNotes   String?
  note          String?
  
  // Custom form fields (JSON)
  customFields String?
  
  // RSVP Status: PENDING | APPROVED | REJECTED
  status String @default("PENDING")
  
  // Submission channel
  submissionChannel String?
  
  // Timestamps
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation Invitation?
}

// ============================================
// INVITATION PASS
// ============================================

model Invitation {
  id      String @id @default(uuid())
  eventId String
  rsvpId  String @unique
  
  // Credentials
  token      String @unique @default(uuid())
  qrCodeData String
  accessCode String @unique
  
  // Guest Info
  guestName  String
  guestCount Int @default(1)
  
  // Delivery Status
  emailSent    Boolean  @default(false)
  smsSent      Boolean  @default(false)
  whatsappSent Boolean  @default(false)
  pdfGenerated Boolean  @default(false)
  pdfPath      String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp    RSVP     @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  checkIn CheckIn?
}

// ============================================
// CHECK-IN SYSTEM
// ============================================

model CheckIn {
  id           String   @id @default(uuid())
  eventId      String
  invitationId String   @unique
  
  // Check-in details
  checkedInAt DateTime @default(now())
  checkedInBy String?
  notes       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

// ============================================
// GUESTBOOK / MEDIA
// ============================================

model MediaAsset {
  id      String @id @default(uuid())
  eventId String
  
  // Media details
  type        String // video | audio | photo
  filename    String
  filepath    String
  contentType String
  size        Int
  duration    Int?
  
  // Guest info
  guestName String?
  guestNote String?
  
  // Status
  isProcessed Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ============================================
// TICKETING & PAYMENTS
// ============================================

model Transaction {
  id      String @id @default(uuid())
  eventId String
  
  // Payment details
  amount          Float
  currency        String @default("USD")
  paymentMethod   String
  paymentGateway  String
  gatewayRef      String?
  
  // Status
  status String @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  
  // Customer info
  customerName  String
  customerEmail String
  customerPhone String?
  
  // Metadata
  metadata String? // JSON
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PayoutWallet {
  id      String @id @default(uuid())
  eventId String @unique
  
  // Wallet details (same as OwnerWallet structure)
  bankName           String?
  accountName        String?
  accountNumber      String?
  routingNumber      String?
  swiftCode          String?
  mobileProvider     String?
  mobileNumber       String?
  paypalEmail        String?
  stripeAccountId    String?
  paystackSubaccount String?
  
  // Settings
  preferredMethod String @default("bank")
  currency        String @default("USD")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id      String @id @default(uuid())
  ownerId String
  
  // Payout details
  amount        Float
  currency      String @default("USD")
  method        String
  accountDetails String // JSON
  
  // Status
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | PROCESSED
  processedAt DateTime?
  processedBy String?
  txnReference String?
  notes        String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// ============================================
// NOTIFICATIONS
// ============================================

model Broadcast {
  id      String @id @default(uuid())
  eventId String
  
  // Message details
  subject String
  message String
  
  // Channels
  sendEmail    Boolean @default(false)
  sendSms      Boolean @default(false)
  sendWhatsapp Boolean @default(false)
  
  // Recipients
  recipientFilter String? // JSON: { status: "APPROVED", ... }
  
  // Status
  status     String    @default("PENDING") // PENDING | SENT | FAILED
  sentAt     DateTime?
  sentCount  Int       @default(0)
  failCount  Int       @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ============================================
// AUDIT LOGGING
// ============================================

model AuditLog {
  id      String @id @default(uuid())
  eventId String?
  adminId String?
  
  // Action details
  action      String
  entity      String
  entityId    String?
  oldValues   String? // JSON
  newValues   String? // JSON
  ipAddress   String?
  userAgent   String?
  
  createdAt DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}
