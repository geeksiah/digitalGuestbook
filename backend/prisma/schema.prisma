// Digital Event Platform - Prisma Schema
// Following SRS: Event Phases, RSVP with Approval Gating, Check-In, Guestbook

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // For Supabase on Render.com (IPv4-only platforms):
  // DATABASE_URL: Use Session Pooler (for app queries) - IPv4 compatible, supports prepared statements
  //   Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true
  // DIRECT_URL: Use Session Pooler (for migrations/schema operations) - IPv4 compatible, supports DDL
  //   Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true
  // Note: Use Session Pooler (port 5432) NOT Transaction Pooler (port 6543) for schema operations
  // Note: Direct Connection (db.*.supabase.co) requires IPv6 and doesn't work on Render.com
}

// ============================================
// ADMIN & AUTHENTICATION
// ============================================

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // admin | superadmin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  auditLogs             AuditLog[]
  reviewedEvents        Event[]                @relation("EventApprovalReviewer")
  pushCampaigns         PushCampaign[]         @relation("PushCampaignCreatedByAdmin")
  rsvpStatusAudits      RSVPStatusAudit[]      @relation("RsvpStatusChangedByAdmin")
  passwordResetRequests PasswordResetRequest[]
}

// ============================================
// OWNER/CLIENT ACCOUNTS
// ============================================

model Owner {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String? // Optional for backward compatibility - admin-created owners don't need passwords
  name         String
  phone        String?
  company      String?

  // Account Status
  isActive Boolean @default(true)

  // Email verification
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  events                 Event[]
  wallet                 OwnerWallet?
  passwordResetRequests  PasswordResetRequest[]
  sentRsvpInvites        RsvpInvite[]
  notificationPreference OwnerNotificationPreference?
  devices                OwnerDevice[]
  notifications          OwnerNotification[]
  pushDeliveries         PushCampaignDelivery[]
  rsvpStatusAudits       RSVPStatusAudit[]            @relation("RsvpStatusChangedByOwner")
}

// Owner Wallet Configuration (for payouts across all events)
model OwnerWallet {
  id      String @id @default(uuid())
  ownerId String @unique

  // Bank Account Details
  bankName      String?
  accountName   String?
  accountNumber String?
  routingNumber String? // For US banks
  swiftCode     String? // For international

  // Mobile Money (Africa)
  mobileProvider String? // mpesa | mtn | airtel
  mobileNumber   String?

  // Digital Wallets
  paypalEmail                String?
  stripeAccountId            String? // Stripe Connect account
  paystackSubaccount         String?
  paystackRecipientCode      String?
  paystackRecipientType      String?
  paystackRecipientName      String?
  paystackRecipientBankCode  String?
  paystackRecipientUpdatedAt DateTime?

  // Payout Preferences
  preferredMethod     String  @default("bank") // bank | mobile | paypal | stripe | paystack
  currency            String  @default("USD")
  autoPayoutEnabled   Boolean @default(false)
  autoPayoutThreshold Float   @default(100) // Minimum balance to trigger auto-payout

  // Verification
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model OwnerNotificationPreference {
  id      String @id @default(uuid())
  ownerId String @unique

  notificationsEnabled Boolean @default(true)
  marketingEnabled     Boolean @default(true)
  soundEnabled         Boolean @default(true)
  hapticsEnabled       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model OwnerDevice {
  id      String @id @default(uuid())
  ownerId String

  platform          String // android | ios | web
  oneSignalPlayerId String?
  appVersion        String?
  deviceModel       String?
  osVersion         String?
  isActive          Boolean  @default(true)
  lastSeenAt        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      Owner                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deliveries PushCampaignDelivery[]

  @@index([ownerId, isActive])
  @@index([oneSignalPlayerId])
}

model OwnerNotification {
  id      String @id @default(uuid())
  ownerId String

  type      String    @default("SYSTEM")
  title     String
  body      String
  deepLink  String?
  dataJson  String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  owner      Owner                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deliveries PushCampaignDelivery[]

  @@index([ownerId, createdAt])
  @@index([ownerId, isRead])
}

// Password Reset Requests (pending admin approval)
model PasswordResetRequest {
  id              String    @id @default(uuid())
  ownerId         String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason          String? // Owner's reason for requesting reset
  newPasswordHash String? // Set when admin approves (temporary until owner sets new password)
  approvedBy      String? // Admin ID who approved/rejected
  rejectedReason  String? // Reason for rejection
  expiresAt       DateTime? // Expiration for approved requests
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  owner Owner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
}

// ============================================
// EVENT MANAGEMENT
// ============================================

model Event {
  id          String    @id @default(uuid())
  slug        String    @unique // URL-friendly identifier
  name        String
  description String?
  date        DateTime
  endDate     DateTime?
  timezone    String    @default("UTC")
  venue       String?
  defaultCurrency String @default("USD")

  // Social metadata
  socialTitle       String?
  socialDescription String?
  coverImagePath    String?
  coverImageAlt     String?

  // Event Owner Contact Information
  ownerName        String?
  ownerEmail       String?
  ownerPhone       String?
  organizationName String?

  // Event Styling
  primaryColor   String @default("#FFD700") // Gold
  secondaryColor String @default("#1a1a2e") // Navy
  accentColor    String @default("#ffffff") // White

  // Event Phase Control (Critical per SRS Section 3)
  // Values: PRE_EVENT | LIVE | POST_EVENT
  phase         String  @default("PRE_EVENT")
  phaseOverride Boolean @default(false) // Manual override flag

  // Service Flags (per Build Plan - modular services)
  invitationEnabled Boolean @default(true)
  rsvpEnabled       Boolean @default(true)
  guestbookEnabled  Boolean @default(true)
  checkInEnabled    Boolean @default(true)

  // Invitation-Only Flag (Critical per SRS Section 4.3)
  invitationOnly   Boolean @default(false)
  strictInviteOnly Boolean @default(false)

  // Owner submission approval workflow
  approvalStatus            String    @default("APPROVED") // PENDING_REVIEW | APPROVED | REJECTED
  approvalSubmittedAt       DateTime?
  approvalReviewedAt        DateTime?
  approvalReviewedByAdminId String?
  approvalRejectionReason   String?

  // Itinerary/Gifting toggles
  itineraryEnabled        Boolean @default(false)
  itineraryTemplateId     String?
  giftingEnabled          Boolean @default(false)
  itineraryPageTemplateId String?
  giftingPageTemplateId   String?

  // Template Assignments
  invitationTemplateId     String?
  rsvpTemplateId           String?
  guestbookTemplateId      String?
  guestbookVideoTemplateId String?
  guestbookAudioTemplateId String?
  guestbookPhotoTemplateId String?
  boothTemplateId          String?
  thankYouTemplateId       String?
  liveLandingTemplateId    String? // Landing page during LIVE phase
  eventEndedTemplateId     String? // Landing page after POST_EVENT

  // Event Owner Portal Access
  ownerAccessToken String @unique @default(uuid())

  // Guestbook Settings
  maxRecordingDuration Int @default(120) // seconds (30-120 per SRS)
  minRecordingDuration Int @default(30)
  maxPhotosPerGuest    Int @default(5)

  // PhotoBooth settings
  maxPhotosPerBoothSession Int @default(10)
  boothShutterCountdown    Int @default(3)

  // Reel Generation (Admin toggle per event)
  reelEnabled Boolean @default(false)

  // Notification Settings per Event
  notifyOnRsvp          Boolean @default(true)
  notifyOnCheckIn       Boolean @default(false)
  notifyOnGuestbook     Boolean @default(false)
  emailNotifications    Boolean @default(true)
  smsNotifications      Boolean @default(false)
  whatsappNotifications Boolean @default(false)

  // RSVP/Ticketing Mode
  rsvpMode        String  @default("free") // free | paid
  requireApproval Boolean @default(true) // Auto-approve if false

  // Ticketing Settings (only used when rsvpMode = "paid")
  ticketingEnabled     Boolean @default(false)
  feeOverridesEnabled  Boolean @default(false) // If true, event-level fees override system defaults
  platformFeeMode      String  @default("PERCENTAGE") // PERCENTAGE | FIXED
  platformFeePercent   Float   @default(5.0) // Platform fee percentage
  platformFeeFixed     Float? // Optional fixed platform fee amount per transaction
  processingFeePercent Float   @default(2.9) // Payment processing fee %
  processingFeeFixed   Float   @default(0.30) // Fixed processing fee per txn

  // Booth/Kiosk Template IDs (for video/audio/photo pages)
  boothVideoTemplateId String?
  boothAudioTemplateId String?
  boothPhotoTemplateId String?

  // Metadata
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  approvalReviewedByAdmin Admin?             @relation("EventApprovalReviewer", fields: [approvalReviewedByAdminId], references: [id], onDelete: SetNull)
  invitationTemplate      Template?          @relation("InvitationTemplate", fields: [invitationTemplateId], references: [id])
  rsvpTemplate            Template?          @relation("RsvpTemplate", fields: [rsvpTemplateId], references: [id])
  guestbookTemplate       Template?          @relation("GuestbookTemplate", fields: [guestbookTemplateId], references: [id])
  guestbookVideoTemplate  Template?          @relation("GuestbookVideoTemplate", fields: [guestbookVideoTemplateId], references: [id])
  guestbookAudioTemplate  Template?          @relation("GuestbookAudioTemplate", fields: [guestbookAudioTemplateId], references: [id])
  guestbookPhotoTemplate  Template?          @relation("GuestbookPhotoTemplate", fields: [guestbookPhotoTemplateId], references: [id])
  boothTemplate           Template?          @relation("BoothTemplate", fields: [boothTemplateId], references: [id])
  boothVideoTemplate      Template?          @relation("BoothVideoTemplate", fields: [boothVideoTemplateId], references: [id])
  boothAudioTemplate      Template?          @relation("BoothAudioTemplate", fields: [boothAudioTemplateId], references: [id])
  boothPhotoTemplate      Template?          @relation("BoothPhotoTemplate", fields: [boothPhotoTemplateId], references: [id])
  thankYouTemplate        Template?          @relation("ThankYouTemplate", fields: [thankYouTemplateId], references: [id])
  liveLandingTemplate     Template?          @relation("LiveLandingTemplate", fields: [liveLandingTemplateId], references: [id])
  eventEndedTemplate      Template?          @relation("EventEndedTemplate", fields: [eventEndedTemplateId], references: [id])
  itineraryPageTemplate   Template?          @relation("ItineraryPageTemplate", fields: [itineraryPageTemplateId], references: [id])
  giftingPageTemplate     Template?          @relation("GiftingPageTemplate", fields: [giftingPageTemplateId], references: [id])
  itineraryTemplate       ItineraryTemplate? @relation("EventSelectedItineraryTemplate", fields: [itineraryTemplateId], references: [id])

  rsvps                RSVP[]
  invitations          Invitation[]
  checkIns             CheckIn[]
  mediaAssets          MediaAsset[]
  broadcasts           Broadcast[]
  auditLogs            AuditLog[]
  formFields           EventFormField[]
  ticketTypes          TicketType[]
  promoCodes           PromoCode[]
  eventPaymentGateways EventPaymentGateway[]
  payoutWallet         PayoutWallet?
  transactions         Transaction[]
  payoutRequests       PayoutRequest[]
  reelJobs             ReelJob[]
  boothDownloadTokens  BoothDownloadToken[]
  Owner                Owner?                @relation(fields: [ownerId], references: [id])
  ownerId              String?
  domains              EventDomain[]
  rsvpInvites          RsvpInvite[]
  itineraryItems       EventItineraryItem[]
  itineraryMcSessions  ItineraryMcSession[]
  giftOrders           GiftOrder[]
  giftPackages         EventGiftPackage[]
  rsvpStatusAudits     RSVPStatusAudit[]

  @@index([ownerId, approvalStatus])
  @@index([approvalStatus, approvalSubmittedAt])
}

// ============================================
// REEL GENERATION
// ============================================

model ReelJob {
  id      String @id @default(uuid())
  eventId String

  // Job Status
  status   String @default("pending") // pending | processing | completed | failed
  progress Int    @default(0) // 0-100 percentage

  // Configuration
  maxDuration Int @default(300) // Max reel duration in seconds

  // Output
  outputPath String? // Path to generated reel
  outputSize Int? // File size in bytes
  duration   Int? // Actual duration in seconds

  // Error Handling
  errorMessage String?
  retryCount   Int     @default(0)

  // Metadata
  videoCount  Int       @default(0) // Number of videos included
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ============================================
// EVENT OWNER PAYOUT SYSTEM
// ============================================

// Payout Wallet Configuration per Event
model PayoutWallet {
  id      String @id @default(uuid())
  eventId String @unique

  // Bank Account Details
  bankName      String?
  accountName   String?
  accountNumber String?
  routingNumber String? // For US banks
  swiftCode     String? // For international

  // Mobile Money (Africa)
  mobileProvider String? // mpesa | mtn | airtel
  mobileNumber   String?

  // Digital Wallets
  paypalEmail        String?
  stripeAccountId    String? // Stripe Connect account
  paystackSubaccount String?

  // Payout Preferences
  preferredMethod     String  @default("bank") // bank | mobile | paypal | stripe | paystack
  currency            String  @default("USD")
  autoPayoutEnabled   Boolean @default(false)
  autoPayoutThreshold Float   @default(100) // Minimum balance to trigger auto-payout

  // Verification
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Sales Transactions
model Transaction {
  id      String  @id @default(uuid())
  eventId String
  rsvpId  String?

  // Transaction Type
  type String // ticket_sale | refund | fee | payout

  // Amount Details
  grossAmount   Float // Total amount charged
  platformFee   Float // Platform's cut
  processingFee Float // Payment processor fee
  netAmount     Float // Amount to event owner
  currency      String @default("USD")

  // Payment Info
  paymentMethod String? // stripe | paystack | paypal | cash
  paymentRef    String? // External payment reference

  // Ticket Info
  ticketTypeName String?
  ticketQuantity Int     @default(1)
  buyerName      String?
  buyerEmail     String?

  // Status
  status String @default("pending") // pending | completed | refunded | failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Payout Requests from Event Owners
model PayoutRequest {
  id      String @id @default(uuid())
  eventId String

  // Request Details
  requestedAmount Float
  currency        String @default("USD")
  payoutMethod    String // bank | mobile | paypal | stripe | paystack

  // Status
  status       String @default("PENDING") // PENDING | PROCESSING | FULFILLED | DELAYED | REJECTED
  ledgerStatus String @default("REQUESTED") // REQUESTED | TRANSFER_PENDING | TRANSFER_SUCCESS | TRANSFER_FAILED | TRANSFER_REVERSED | REJECTED | MANUAL_REVIEW

  // Processing Info
  processedAt              DateTime?
  processedBy              String? // Admin ID
  payoutReference          String?   @unique // Internal payout reference
  transactionRef           String? // External payout reference (legacy/manual)
  gateway                  String? // paystack | manual
  gatewayTransferCode      String?   @unique
  gatewayTransferReference String?   @unique
  gatewayRecipientCode     String?
  gatewayStatus            String?
  reconciliationVersion    Int       @default(0)
  webhookLastEvent         String?
  webhookLastPayload       String?
  failureCode              String?
  failureMessage           String?
  reconciledAt             DateTime?
  rejectionReason          String?
  requestedByOwnerId       String?

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PaystackWebhookEvent {
  id           String    @id @default(uuid())
  dedupeKey    String    @unique
  event        String
  reference    String?
  transferCode String?
  payload      String
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([event])
  @@index([reference])
  @@index([transferCode])
}

// ============================================
// TEMPLATE SYSTEM (Build Plan Increment 2)
// ============================================

model Template {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Template Type: INVITATION | RSVP | GUESTBOOK | GUESTBOOK_VIDEO | GUESTBOOK_AUDIO | GUESTBOOK_PHOTO | THANK_YOU | BOOTH | BOOTH_VIDEO | BOOTH_AUDIO | BOOTH_PHOTO
  type String

  // Template Content (HTML/CSS/JS bundle)
  htmlContent String
  cssContent  String?
  jsContent   String?

  // Template Assets (for ZIP-based templates)
  assetsPath    String? // Directory path where template assets are stored (for ZIP uploads)
  thumbnailPath String? // Thumbnail/preview image path

  // Template Variables (JSON schema for injection)
  variables String? // JSON string of available variables

  // Metadata
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Events using this template
  eventsAsInvitation     Event[] @relation("InvitationTemplate")
  eventsAsRsvp           Event[] @relation("RsvpTemplate")
  eventsAsGuestbook      Event[] @relation("GuestbookTemplate")
  eventsAsGuestbookVideo Event[] @relation("GuestbookVideoTemplate")
  eventsAsGuestbookAudio Event[] @relation("GuestbookAudioTemplate")
  eventsAsGuestbookPhoto Event[] @relation("GuestbookPhotoTemplate")
  eventsAsBooth          Event[] @relation("BoothTemplate")
  eventsAsBoothVideo     Event[] @relation("BoothVideoTemplate")
  eventsAsBoothAudio     Event[] @relation("BoothAudioTemplate")
  eventsAsBoothPhoto     Event[] @relation("BoothPhotoTemplate")
  eventsAsThankYou       Event[] @relation("ThankYouTemplate")
  eventsAsLiveLanding    Event[] @relation("LiveLandingTemplate")
  eventsAsEventEnded     Event[] @relation("EventEndedTemplate")
  eventsAsItineraryPage  Event[] @relation("ItineraryPageTemplate")
  eventsAsGiftingPage    Event[] @relation("GiftingPageTemplate")
}

// ============================================
// RSVP SYSTEM (SRS Sections 4-7)
// ============================================

model RSVP {
  id      String @id @default(uuid())
  eventId String

  // Guest Information (SRS Section 4.2)
  primaryName   String
  secondaryName String?
  email         String?
  phone         String?

  // Response (Yes / No / Maybe)
  attendance     String  @default("PENDING") // YES | NO | MAYBE | PENDING
  guestCount     Int     @default(1)
  mealPreference String?
  dietaryNotes   String?
  note           String?

  // Custom Fields Data (JSON - flexible per-event fields)
  customFields String? // JSON object with custom field responses

  // RSVP Status (Critical - SRS Section 4.3)
  // Values: PENDING | APPROVED | REJECTED
  status String @default("PENDING")

  // Channel used for submission (for rejection notification)
  submissionChannel String? // EMAIL | SMS | WHATSAPP | WEB

  // Payment/Ticket Info (if event uses ticketing)
  ticketType     String? // Ticket type purchased
  ticketQuantity Int? // Number of tickets
  amountPaid     Float? // Amount paid in cents
  currency       String? // USD, NGN, etc.
  paymentStatus  String? // PENDING | PAID | REFUNDED | FAILED
  paymentMethod  String? // stripe | paystack | cash | free
  paymentRef     String? // External payment reference
  paymentDate    DateTime?

  // Timestamps
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String? // Admin ID who reviewed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation    Invitation?
  invites       RsvpInvite[]
  statusHistory RSVPStatusAudit[]
}

model RSVPStatusAudit {
  id      String @id @default(uuid())
  rsvpId  String
  eventId String

  fromStatus String
  toStatus   String
  reason     String?

  changedByOwnerId String?
  changedByAdminId String?
  changedAt        DateTime @default(now())

  rsvp           RSVP   @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  event          Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  changedByOwner Owner? @relation("RsvpStatusChangedByOwner", fields: [changedByOwnerId], references: [id], onDelete: SetNull)
  changedByAdmin Admin? @relation("RsvpStatusChangedByAdmin", fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([rsvpId, changedAt])
  @@index([eventId, changedAt])
}

// ============================================
// PROMO CODES (SRS Section 7.3)
// ============================================

model PromoCode {
  id          String  @id @default(uuid())
  eventId     String
  code        String // e.g., "SUMMER2024"
  description String?

  // Discount Configuration
  discountType    String // PERCENT | FIXED
  discountValue   Float // e.g., 10 for 10% or $10 off
  minimumPurchase Float? // Minimum purchase amount to apply
  maximumDiscount Float? // Maximum discount amount (for percentage)

  // Applicability
  ticketTypeIds String? // JSON array of ticket type IDs (null = all tickets)
  usageLimit    Int? // Total number of times code can be used (null = unlimited)
  usageCount    Int     @default(0)
  maxPerUser    Int     @default(1) // Max times a single user can use

  // Validity
  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@index([eventId, code])
}

// Custom RSVP/Ticket Fields per Event
model EventFormField {
  id      String @id @default(uuid())
  eventId String

  // Field Configuration
  fieldName   String // Internal name (e.g., "company_name")
  label       String // Display label (e.g., "Company Name")
  type        String // text | email | phone | number | select | checkbox | radio | textarea | date
  placeholder String?
  helpText    String?

  // Options for select/radio/checkbox (JSON array)
  options String? // ["Option 1", "Option 2", "Option 3"]

  // Validation
  required  Boolean @default(false)
  minLength Int?
  maxLength Int?
  pattern   String? // Regex pattern

  // Display Order
  sortOrder Int @default(0)

  // Visibility
  isActive           Boolean @default(true)
  showOnConfirmation Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Ticket Types for Paid Events
model TicketType {
  id      String @id @default(uuid())
  eventId String

  name        String // "General Admission", "VIP", "Early Bird"
  description String?
  price       Float // Price in smallest currency unit (cents)
  currency    String  @default("USD")

  // Availability
  quantityTotal Int @default(0) // 0 = unlimited
  quantitySold  Int @default(0)
  maxPerOrder   Int @default(10)

  // Sales Window
  saleStartDate DateTime?
  saleEndDate   DateTime?

  // Display
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Payment Gateway Configuration per Event
// System-wide Payment Gateway Configuration
// Admin configures all available payment gateways here
model PaymentGateway {
  id          String  @id @default(uuid())
  name        String // Display name (e.g., "Stripe Production", "Paystack Test")
  gateway     String // stripe | paystack | flutterwave | paypal | mtn_momo | telecel_cash | airteltigo_cash | custom
  description String? // Optional description

  isActive Boolean @default(true) // Enable/disable this gateway
  isLive   Boolean @default(false) // Test vs Live mode

  // Stripe Configuration
  stripePublicKey     String?
  stripeSecretKey     String?
  stripeWebhookSecret String?

  // Paystack Configuration
  paystackPublicKey String?
  paystackSecretKey String?

  // Flutterwave Configuration
  flutterwavePublicKey String?
  flutterwaveSecretKey String?

  // MTN MoMo Configuration
  mtnMomoApiKey          String?
  mtnMomoApiSecret       String?
  mtnMomoSubscriptionKey String?
  mtnMomoEnvironment     String? // sandbox | production

  // Telecel Cash Configuration
  telecelCashApiKey     String?
  telecelCashApiSecret  String?
  telecelCashMerchantId String?

  // Airteltigo Cash Configuration
  airteltigoCashApiKey     String?
  airteltigoCashApiSecret  String?
  airteltigoCashMerchantId String?

  // Custom Gateway Configuration
  customGatewayName      String?
  customGatewayApiUrl    String?
  customGatewayApiKey    String?
  customGatewayApiSecret String?
  customGatewayConfig    String? // JSON string for additional config

  // Common Settings
  currency   String  @default("USD")
  successUrl String?
  cancelUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  events EventPaymentGateway[]
}

// Junction table: Which payment gateways are enabled for each event
model EventPaymentGateway {
  id               String @id @default(uuid())
  eventId          String
  paymentGatewayId String

  // Event-specific settings (can override gateway defaults)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0) // Order of display in payment options

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentGateway PaymentGateway @relation(fields: [paymentGatewayId], references: [id], onDelete: Cascade)

  @@unique([eventId, paymentGatewayId])
  @@index([eventId])
  @@index([paymentGatewayId])
}

// ============================================
// INVITATION PASS (SRS Section 6)
// ============================================

model Invitation {
  id      String @id @default(uuid())
  eventId String
  rsvpId  String @unique

  // Credentials (SRS Section 6.1)
  token      String @unique @default(uuid()) // Unique attendee token
  qrCodeData String // Base64 encoded QR code
  accessCode String @unique // 6-digit numeric code

  // Guest Info (denormalized for PDF generation)
  guestName  String
  guestCount Int    @default(1)

  // Delivery Status
  emailSent    Boolean @default(false)
  smsSent      Boolean @default(false)
  whatsappSent Boolean @default(false)
  pdfGenerated Boolean @default(false)
  pdfPath      String?

  // Check-in Status
  isCheckedIn Boolean   @default(false)
  checkedInAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp     RSVP      @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]
}

// ============================================
// BOOTH DOWNLOAD TOKENS
// ============================================

model BoothDownloadToken {
  id        String    @id @default(uuid())
  mediaId   String?   @unique // Optional: for backward compatibility with single photo downloads
  sessionId String? // Session identifier (deviceId + timestamp window) for multi-photo downloads
  eventId   String // Event ID for session-based queries
  deviceId  String? // Device ID for session grouping
  token     String    @unique // Secure download token
  expiresAt DateTime // Token expiration (24 hours)
  used      Boolean   @default(false) // Track if token has been used
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  media MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([mediaId])
  @@index([sessionId])
  @@index([eventId, deviceId, createdAt])
  @@index([expiresAt])
}

// ============================================
// CHECK-IN SYSTEM (SRS Section 8)
// ============================================

model CheckIn {
  id           String @id @default(uuid())
  eventId      String
  invitationId String

  // Check-in Method (SRS Section 8.1)
  method String // QR_SCAN | MANUAL_CODE

  // Validation Result
  success       Boolean
  failureReason String? // INVALID | ALREADY_USED | NOT_APPROVED

  // Device Info
  deviceInfo String?
  ipAddress  String?

  // Timestamp
  checkedInAt DateTime @default(now())

  // Relations
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

// ============================================
// GUESTBOOK & MEDIA (SRS Section 9-10)
// ============================================

model MediaAsset {
  id      String @id @default(uuid())
  eventId String

  // Media Type: VIDEO | AUDIO | PHOTO
  type String

  // Guest Info (optional - anonymous allowed)
  guestName  String?
  guestEmail String?

  // File Information
  fileName String
  filePath String
  fileSize Int // bytes
  mimeType String
  duration Int? // seconds (for video/audio)

  // Processing Status
  status        String  @default("UPLOADING") // UPLOADING | READY | FAILED | PROCESSING_THUMBNAIL
  thumbnailPath String?

  // Access Mode (SRS Section 9.1)
  captureMode String @default("PERSONAL") // PERSONAL | BOOTH

  // Device fingerprint (for upload limits)
  deviceId String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  downloadToken BoothDownloadToken?

  @@index([eventId, type, deviceId, createdAt])
  @@index([eventId, captureMode, deviceId, createdAt])
  @@index([eventId, status])
}

// ============================================
// BROADCAST MESSAGING (SRS Section 11)
// ============================================

model Broadcast {
  id      String @id @default(uuid())
  eventId String

  // Message Content
  subject String?
  message String

  // Target Audience: ALL_RSVPS | APPROVED_ONLY
  audience String

  // Channels Used
  channels String // JSON array: ["EMAIL", "SMS", "WHATSAPP"]

  // Delivery Stats
  totalRecipients Int @default(0)
  deliveredCount  Int @default(0)
  failedCount     Int @default(0)

  // Status: DRAFT | SENDING | SENT | FAILED
  status String    @default("DRAFT")
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PushCampaign {
  id    String @id @default(uuid())
  title String
  body  String

  deepLink         String?
  status           String    @default("DRAFT") // DRAFT | QUEUED | SENT | FAILED | SCHEDULED
  scheduledAt      DateTime?
  sentAt           DateTime?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdByAdmin Admin?                 @relation("PushCampaignCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  audiences      PushCampaignAudience[]
  deliveries     PushCampaignDelivery[]

  @@index([status, scheduledAt])
}

model PushCampaignAudience {
  id         String @id @default(uuid())
  campaignId String

  audienceType  String // ALL_OWNERS | ACTIVE_OWNERS | PENDING_APPROVAL_OWNERS | CUSTOM_OWNER_IDS
  audienceQuery String?
  createdAt     DateTime @default(now())

  campaign PushCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model PushCampaignDelivery {
  id      String @id @default(uuid())
  ownerId String

  campaignId          String?
  ownerNotificationId String?
  deviceId            String?
  oneSignalPlayerId   String?
  status              String    @default("QUEUED") // QUEUED | SENT | FAILED | OPENED | CLICKED
  failureReason       String?
  sentAt              DateTime?
  openedAt            DateTime?
  clickedAt           DateTime?
  createdAt           DateTime  @default(now())

  campaign          PushCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner             Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerNotification OwnerNotification? @relation(fields: [ownerNotificationId], references: [id], onDelete: SetNull)
  device            OwnerDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([ownerId, status])
  @@index([ownerNotificationId])
}

// ============================================
// CUSTOM DOMAINS
// ============================================

model EventDomain {
  id                String   @id @default(uuid())
  eventId           String
  host              String   @unique
  isPrimary         Boolean  @default(false)
  status            String   @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | VERIFIED | ACTIVE | FAILED
  verificationToken String
  verificationNotes String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
}

// ============================================
// WHATSAPP RSVP INVITES
// ============================================

model RsvpInvite {
  id                String    @id @default(uuid())
  eventId           String
  rsvpId            String?
  token             String    @unique
  inviteeName       String?
  inviteePhone      String
  inviteeEmail      String?
  providerMessageId String?
  status            String    @default("SENT") // SENT | OPENED | RESPONDED | EXPIRED
  initialResponse   String? // YES | NO
  partySize         Int?
  note              String?
  sentByOwnerId     String?
  openedAt          DateTime?
  respondedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp   RSVP?  @relation(fields: [rsvpId], references: [id], onDelete: SetNull)
  sender Owner? @relation(fields: [sentByOwnerId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([status])
  @@index([providerMessageId])
}

model WhatsappWebhookEvent {
  id                String    @id @default(uuid())
  provider          String // META | TWILIO
  providerMessageId String    @unique
  eventType         String?
  payload           String
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([provider])
}

// ============================================
// ITINERARY
// ============================================

model ItineraryTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  itemsJson   String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  eventsUsingAsDefault Event[]              @relation("EventSelectedItineraryTemplate")
  items                EventItineraryItem[]
}

model ItineraryMcSession {
  id          String    @id @default(uuid())
  eventId     String
  token       String    @unique
  displayName String?
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  completedItems EventItineraryItem[] @relation("ItineraryItemCompletedBySession")

  @@index([eventId])
}

model EventItineraryItem {
  id                   String    @id @default(uuid())
  eventId              String
  templateId           String?
  title                String
  description          String?
  startsAt             DateTime?
  endsAt               DateTime?
  location             String?
  sortOrder            Int       @default(0)
  isCompleted          Boolean   @default(false)
  completedAt          DateTime?
  completedBySessionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template           ItineraryTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  completedBySession ItineraryMcSession? @relation("ItineraryItemCompletedBySession", fields: [completedBySessionId], references: [id], onDelete: SetNull)

  @@index([eventId, sortOrder])
  @@index([templateId])
}

// ============================================
// GIFTING
// ============================================

model GiftPackage {
  id            String   @id @default(uuid())
  name          String
  description   String?
  price         Float
  currency      String   @default("USD")
  thumbnailPath String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  items  GiftOrderItem[]
  events EventGiftPackage[]
}

model EventGiftPackage {
  id            String   @id @default(uuid())
  eventId       String
  giftPackageId String
  createdAt     DateTime @default(now())

  // Relations
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  giftPackage GiftPackage @relation(fields: [giftPackageId], references: [id], onDelete: Cascade)

  @@unique([eventId, giftPackageId])
  @@index([eventId])
  @@index([giftPackageId])
}

model GiftOrder {
  id               String    @id @default(uuid())
  eventId          String
  guestName        String
  guestPhone       String?
  guestEmail       String?
  deliveryDate     DateTime?
  note             String?
  paymentMethod    String?
  paymentReference String?
  currency         String    @default("USD")
  totalAmount      Float     @default(0)
  cashGiftAmount   Float?
  status           String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | CANCELLED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  event Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items GiftOrderItem[]

  @@index([eventId, status])
}

model GiftOrderItem {
  id            String   @id @default(uuid())
  orderId       String
  giftPackageId String?
  type          String // CASH | PACKAGE
  quantity      Int      @default(1)
  unitPrice     Float
  lineTotal     Float
  createdAt     DateTime @default(now())

  // Relations
  order       GiftOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  giftPackage GiftPackage? @relation(fields: [giftPackageId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSettings {
  id String @id @default("default")

  // General Settings
  siteName String  @default("Digital Event Platform")
  siteUrl  String?
  logoUrl  String?

  // Feature Toggles
  emailEnabled    Boolean @default(false)
  smsEnabled      Boolean @default(false)
  whatsappEnabled Boolean @default(false)

  // Owner app update + support controls
  ownerMobileLatestVersion   String?
  ownerMobileMinimumVersion  String?
  ownerMobileAndroidStoreUrl String?
  ownerMobileIosStoreUrl     String?
  supportEmail               String?
  supportWhatsAppNumber      String?
  faqContentJson             String?

  // Push provider settings
  oneSignalAppId  String?
  oneSignalApiKey String?

  // Global commerce fee defaults
  platformFeeMode      String @default("PERCENTAGE") // PERCENTAGE | FIXED
  platformFeePercent   Float  @default(5.0) // Platform fee percentage
  platformFeeFixed     Float? // Optional fixed fee amount
  processingFeePercent Float  @default(2.9) // Processor fee percentage
  processingFeeFixed   Float  @default(0.30) // Processor fixed fee

  // Default providers (reference by id)
  defaultEmailProviderId    String?
  defaultSmsProviderId      String?
  defaultWhatsappProviderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Email Provider (SMTP, SendGrid, Mailgun, etc.)
model EmailProvider {
  id        String  @id @default(uuid())
  name      String // Display name
  provider  String // smtp | sendgrid | mailgun | ses
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  // SMTP Settings
  smtpHost   String?
  smtpPort   Int?
  smtpUser   String?
  smtpPass   String?
  smtpSecure Boolean @default(true)

  // SendGrid / API-based
  apiKey String?

  // Common fields
  fromEmail String?
  fromName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SMS Provider (Twilio, Vonage, Africa's Talking, etc.)
model SmsProvider {
  id        String  @id @default(uuid())
  name      String // Display name
  provider  String // twilio | vonage | africastalking | termii | arkesel
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  // Twilio Settings
  accountSid  String?
  authToken   String?
  phoneNumber String?

  // API-based providers (Termii, Arkesel, Africa's Talking, etc.)
  apiKey    String? // API key for Arkesel, Termii, Africa's Talking
  apiSecret String? // API secret (for some providers)
  senderId  String? // Sender ID / From number (required for Arkesel, Termii)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// WhatsApp Provider (Twilio, Meta Cloud API, etc.)
model WhatsappProvider {
  id        String  @id @default(uuid())
  name      String // Display name
  provider  String // twilio | meta
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  // Twilio WhatsApp Settings
  accountSid  String?
  authToken   String?
  phoneNumber String?

  // Meta Cloud API Settings
  apiKey        String?
  phoneNumberId String?
  businessId    String?
  accessToken   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// AUDIT LOG (Non-Functional - Auditability)
// ============================================

model AuditLog {
  id      String  @id @default(uuid())
  eventId String?
  adminId String?

  // Action Type
  action String // RSVP_APPROVED | RSVP_REJECTED | CHECK_IN | PHASE_CHANGE | etc.

  // Target Entity
  entityType String? // RSVP | INVITATION | EVENT | MEDIA
  entityId   String?

  // Details
  details String? // JSON string with action details

  // Request Info
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  // Relations
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}
