# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# JWT Secret (Required)
JWT_SECRET="your-secret-key-here-minimum-32-characters"

# Admin Credentials (Required in production, optional in development)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-in-production"
ADMIN_NAME="Platform Admin"

# Node Environment
NODE_ENV="production"
PORT="10000"

# CORS & Frontend
CORS_ORIGIN="https://your-frontend-domain.com"
FRONTEND_URL="https://your-frontend-domain.com"

# Supabase Storage (Required for file uploads)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Email Configuration (Optional - used as default if no provider configured in admin)
# The system will automatically create a default email provider from these variables
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@your-domain.com"
SMTP_FROM_NAME="Digital Event Platform"

# Alternative: Use DEFAULT_EMAIL_* prefix (same functionality)
# DEFAULT_EMAIL_HOST="smtp.gmail.com"
# DEFAULT_EMAIL_PORT="587"
# DEFAULT_EMAIL_USER="your-email@gmail.com"
# DEFAULT_EMAIL_PASS="your-app-password"
# DEFAULT_EMAIL_FROM="noreply@your-domain.com"
# DEFAULT_EMAIL_FROM_NAME="Digital Event Platform"
# DEFAULT_EMAIL_SECURE="false"  # true for port 465, false for port 587

# SMS Configuration (Optional - Twilio)
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# WhatsApp Configuration (Optional - Twilio)
TWILIO_WHATSAPP_NUMBER="whatsapp:+1234567890"

# Owner platform rollout feature flags
FF_OWNER_EVENT_APPROVAL="true"
FF_OWNER_PUSH="true"
FF_OWNER_MARKETING_CAMPAIGNS="true"
FF_OWNER_UPDATE_CHECK="true"
FF_OWNER_MEDIA_ALBUMS_MOBILE="true"

# OneSignal (for owner push notifications + marketing campaigns)
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""


# Custom domains / Netlify frontend hosting
# Branded CNAME shown to customers. Configure cname.eventpeepo.com to point to the Netlify site hostname.
DOMAIN_CNAME_TARGET="cname.eventpeepo.com"
# Apex A record shown to customers for their bare/root domain.
DOMAIN_APEX_IP="75.2.60.5"
# Required for automatic alias attach/detach and Let's Encrypt certificate lifecycle.
NETLIFY_SITE_ID="your-netlify-site-id"
NETLIFY_AUTH_TOKEN="your-netlify-personal-access-token"
