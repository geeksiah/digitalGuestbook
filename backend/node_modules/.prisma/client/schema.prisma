generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite doesn't support enums, so we use String with constraints
// Phase: "PRE_EVENT" | "LIVE" | "POST_EVENT"
// TemplateType: "INVITATION" | "RSVP" | "GUESTBOOK" | "THANK_YOU"
// RsvpResponse: "YES" | "NO" | "MAYBE"
// RsvpStatus: "PENDING" | "APPROVED" | "REJECTED"
// SourceChannel: "WEB" | "EMAIL" | "SMS" | "WHATSAPP"
// InvitationStatus: "ISSUED" | "REVOKED"
// MediaType: "VIDEO" | "AUDIO" | "PHOTO"
// MediaStatus: "UPLOADING" | "READY" | "FAILED"
// MediaSource: "PERSONAL" | "BOOTH"
// BroadcastAudience: "ALL_RSVPS" | "APPROVED_ONLY"
// BroadcastChannel: "EMAIL" | "SMS" | "WHATSAPP"
// DeliveryStatus: "PENDING" | "SENT" | "FAILED"

model Event {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  name                     String
  dateTime                 DateTime
  timezone                 String
  invitationOnly           Boolean  @default(false)
  featureInvitationWebsite Boolean  @default(false)
  featureRsvp              Boolean  @default(false)
  featureGuestbook         Boolean  @default(false)
  manualPhaseOverride      String? // "PRE_EVENT" | "LIVE" | "POST_EVENT"
  coupleAccessKey          String   @default(uuid())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  rsvps               RSVP[]
  templateAssignments TemplateAssignment[]
  invitations         Invitation[]
  checkinLogs         CheckinLog[]
  checkinDevices      CheckinDevice[]
  mediaAssets         MediaAsset[]
  phaseHistory        PhaseHistory[]
  rsvpActionLogs      RsvpActionLog[]
  broadcasts          Broadcast[]
}

model Template {
  id          String               @id @default(cuid())
  name        String
  type        String // "INVITATION" | "RSVP" | "GUESTBOOK" | "THANK_YOU"
  version     Int                  @default(1)
  storagePath String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  assignments TemplateAssignment[]
}

model TemplateAssignment {
  id           String @id @default(cuid())
  eventId      String
  templateId   String
  templateType String // "INVITATION" | "RSVP" | "GUESTBOOK" | "THANK_YOU"

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([eventId, templateType])
}

model RSVP {
  id             String   @id @default(cuid())
  eventId        String
  partyName      String
  guestCount     Int?
  response       String // "YES" | "NO" | "MAYBE"
  mealPreference String?
  note           String?
  status         String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  sourceChannel  String   @default("WEB") // "WEB" | "EMAIL" | "SMS" | "WHATSAPP"
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime @default(now())

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation  Invitation?
  mediaAssets MediaAsset[]
  actionLogs  RsvpActionLog[]
  deliveries  BroadcastDelivery[]

  @@index([eventId, status])
}

model Invitation {
  id            String    @id @default(cuid())
  eventId       String
  rsvpId        String    @unique
  attendeeToken String    @unique
  sixDigitCode  String
  qrPayload     String
  status        String    @default("ISSUED") // "ISSUED" | "REVOKED"
  checkedInAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp        RSVP         @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  checkinLogs CheckinLog[]

  @@unique([eventId, sixDigitCode])
}

model CheckinLog {
  id           String   @id @default(cuid())
  eventId      String
  invitationId String?
  method       String // "QR" | "CODE"
  result       String // "SUCCESS" | "DUPLICATE" | "INVALID" | "UNAPPROVED" | "NOT_FOUND"
  deviceId     String
  createdAt    DateTime @default(now())

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
}

model CheckinDevice {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  apiKey    String   @unique
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  eventId      String
  rsvpId       String?
  source       String // "PERSONAL" | "BOOTH"
  type         String // "VIDEO" | "AUDIO" | "PHOTO"
  durationSec  Int?
  originalPath String
  createdAt    DateTime @default(now())
  status       String   @default("UPLOADING") // "UPLOADING" | "READY" | "FAILED"

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp  RSVP? @relation(fields: [rsvpId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
}

model PhaseHistory {
  id        String   @id @default(cuid())
  eventId   String
  fromPhase String? // "PRE_EVENT" | "LIVE" | "POST_EVENT"
  toPhase   String // "PRE_EVENT" | "LIVE" | "POST_EVENT"
  changedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, changedAt])
}

model RsvpActionLog {
  id        String   @id @default(cuid())
  eventId   String
  rsvpId    String
  action    String // "APPROVE" | "REJECT"
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp  RSVP  @relation(fields: [rsvpId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model Broadcast {
  id        String   @id @default(cuid())
  eventId   String
  audience  String // "ALL_RSVPS" | "APPROVED_ONLY"
  channel   String // "EMAIL" | "SMS" | "WHATSAPP"
  body      String
  createdAt DateTime @default(now())
  sentCount Int      @default(0)

  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries BroadcastDelivery[]

  @@index([eventId, createdAt])
}

model BroadcastDelivery {
  id          String   @id @default(cuid())
  broadcastId String
  rsvpId      String
  status      String   @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  target      String // email or phone
  createdAt   DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  rsvp      RSVP      @relation(fields: [rsvpId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
}
